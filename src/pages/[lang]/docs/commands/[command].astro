---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import DocsMobileNav from "../../../../components/DocsMobileNav.astro";
import en from "../../../../messages/en/docs.json";
import es from "../../../../messages/es/docs.json";

export function getStaticPaths() {
  return [
    { params: { lang: "en", command: "init" } },
    { params: { lang: "es", command: "init" } },
  ];
}

const lang = Astro.params.lang === "es" ? "es" : "en";
const messages = lang === "es" ? es : en;
const command = messages.commandPages[Astro.params.command ?? "init"];
const defaultLabels =
  lang === "es"
    ? { field: "Campo", defaultValue: "Default", meaning: "Significado" }
    : { field: "Field", defaultValue: "Default", meaning: "Meaning" };

function localizeHref(href: string) {
  if (!href.startsWith("/")) return href;
  return `/${lang}${href}`;
}
---

<BaseLayout lang={lang} messages={{ ...messages, meta: { ...messages.meta, title: `${command.title} - mvnex`, ogTitle: `${command.title} - mvnex` } }}>
  <main class="px-6 pb-20 pt-32 sm:px-8 sm:pt-40 lg:px-10">
    <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[17rem_minmax(0,1fr)]">
      <aside class="hidden lg:block">
        <div class="sticky top-24 pl-1">
          {messages.sidebar.map((group) => (
            <nav class="py-4 first:pt-0 last:pb-0" aria-label={group.title}>
              <p class="text-sm font-semibold text-zinc-950 dark:text-white">{group.title}</p>
              <ul class="mt-3 grid gap-2">
                {group.links.map((link) => (
                  <li>
                    <a class="block rounded-md px-2 py-1.5 text-sm text-zinc-500 transition-colors hover:bg-zinc-100 hover:text-zinc-950 dark:text-zinc-400 dark:hover:bg-zinc-900 dark:hover:text-white" href={localizeHref(link.href)}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))}
        </div>
      </aside>

      <article class="min-w-0">
        <DocsMobileNav lang={lang} groups={messages.sidebar} currentPath={Astro.url.pathname} />

        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-zinc-400">{command.eyebrow}</p>
        <h1 class="mt-5 max-w-4xl font-mono text-5xl font-semibold leading-[0.98] tracking-tight text-zinc-950 dark:text-white sm:text-7xl">
          {command.title}
        </h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-zinc-500 dark:text-zinc-400">{command.description}</p>

        <section class="mt-10">
          <h2 class="text-2xl font-semibold tracking-tight text-zinc-950 dark:text-white">{command.synopsisTitle}</h2>
          <pre class="mt-5 overflow-x-auto rounded-md border border-zinc-800 bg-zinc-950 p-5 text-sm leading-7 text-zinc-100 dark:border-zinc-700 dark:bg-[#111827]"><code>{command.synopsis}</code></pre>
        </section>

        <section class="mt-10">
          <h2 class="text-2xl font-semibold tracking-tight text-zinc-950 dark:text-white">{command.usageTitle}</h2>
          <pre class="mt-5 overflow-x-auto rounded-md border border-zinc-800 bg-zinc-950 p-5 text-sm leading-7 text-zinc-100 dark:border-zinc-700 dark:bg-[#111827]"><code>{command.usage.join("\n")}</code></pre>
        </section>

        {command.examples && (
          <section class="mt-12">
            <h2 class="text-2xl font-semibold tracking-tight text-zinc-950 dark:text-white">{command.examplesTitle}</h2>
            <div class="mt-6 grid gap-8">
              {command.examples.map((example, index) => (
                <div class="grid gap-5 md:grid-cols-[3rem_minmax(0,1fr)]">
                  <span class="font-mono text-sm font-black text-sky-600 dark:text-sky-300">{String(index + 1).padStart(2, "0")}</span>
                  <div class="min-w-0">
                    <h3 class="text-xl font-semibold tracking-tight text-zinc-950 dark:text-white">{example.title}</h3>
                    <p class="mt-2 max-w-2xl text-sm leading-7 text-zinc-500 dark:text-zinc-400">{example.description}</p>
                    <div class="mt-5 max-w-full overflow-hidden rounded-md border border-zinc-800 bg-zinc-950 text-zinc-100 shadow-sm dark:border-zinc-700 dark:bg-[#111827]">
                      <div class="flex items-center justify-between border-b border-white/10 bg-white/[0.03] px-4 py-2 dark:bg-white/[0.05]">
                        <span class="font-mono text-xs text-zinc-400">terminal</span>
                        <button
                          class="rounded-full px-3 py-1 text-xs font-semibold text-zinc-300 transition-colors hover:bg-white/10 hover:text-white"
                          type="button"
                          data-copy-button
                          data-copy-value={example.code}
                        >
                          Copy
                        </button>
                      </div>
                      <pre class="overflow-x-auto p-4 text-sm leading-7"><code>{example.code}</code></pre>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        {command.interactive && (
          <section class="mt-12">
            <h2 class="text-2xl font-semibold tracking-tight text-zinc-950 dark:text-white">{command.interactiveTitle}</h2>
            <ul class="mt-5 grid gap-4">
              {command.interactive.map((item) => (
                <li class="grid gap-3 text-sm leading-7 text-zinc-600 dark:text-zinc-400 sm:grid-cols-[1rem_minmax(0,1fr)]">
                  <span class="mt-3 size-1.5 rounded-full bg-sky-500" aria-hidden="true"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        {command.defaults && (
          <section class="mt-12">
            <h2 class="text-2xl font-semibold tracking-tight text-zinc-950 dark:text-white">{command.defaultsTitle}</h2>
            <div class="mt-6 overflow-hidden rounded-md border border-zinc-200 dark:border-zinc-800">
              <div class="hidden grid-cols-[minmax(8rem,0.8fr)_minmax(7rem,0.7fr)_minmax(0,1.5fr)] bg-zinc-100 text-xs font-semibold uppercase tracking-[0.16em] text-zinc-500 dark:bg-zinc-900 dark:text-zinc-400 sm:grid">
                <span class="px-4 py-3">{defaultLabels.field}</span>
                <span class="px-4 py-3">{defaultLabels.defaultValue}</span>
                <span class="px-4 py-3">{defaultLabels.meaning}</span>
              </div>
              {command.defaults.map((item) => (
                <div class="grid gap-3 border-t border-zinc-200 p-4 text-sm first:border-t-0 dark:border-zinc-800 sm:grid-cols-[minmax(8rem,0.8fr)_minmax(7rem,0.7fr)_minmax(0,1.5fr)] sm:gap-0 sm:p-0 sm:first:border-t">
                  <span class="font-mono font-semibold text-sky-600 dark:text-sky-300 sm:px-4 sm:py-4">{item.name}</span>
                  <span class="font-mono text-zinc-700 dark:text-zinc-300 sm:px-4 sm:py-4">{item.value}</span>
                  <span class="leading-7 text-zinc-500 dark:text-zinc-400 sm:px-4 sm:py-4">{item.description}</span>
                </div>
              ))}
            </div>
          </section>
        )}

        <div class="mt-10 grid gap-10 lg:grid-cols-2">
          <section>
            <h2 class="text-2xl font-semibold tracking-tight text-zinc-950 dark:text-white">{command.argumentsTitle}</h2>
            <div class="mt-5 grid gap-5">
              {command.arguments.map((argument) => (
                <div>
                  <p class="font-mono text-sm font-semibold text-sky-600 dark:text-sky-300">{argument.name}</p>
                  <p class="mt-2 text-sm leading-7 text-zinc-500 dark:text-zinc-400">{argument.description}</p>
                </div>
              ))}
            </div>
          </section>

          <section>
            <h2 class="text-2xl font-semibold tracking-tight text-zinc-950 dark:text-white">{command.optionsTitle}</h2>
            <div class="mt-5 grid gap-5">
              {command.options.map((option) => (
                <div>
                  <p class="font-mono text-sm font-semibold text-sky-600 dark:text-sky-300">{option.flag}</p>
                  <p class="mt-2 text-sm leading-7 text-zinc-500 dark:text-zinc-400">{option.description}</p>
                </div>
              ))}
            </div>
          </section>
        </div>

        <section class="mt-12">
          <h2 class="text-2xl font-semibold tracking-tight text-zinc-950 dark:text-white">{command.behaviorTitle}</h2>
          <ul class="mt-5 grid gap-3 text-sm leading-7 text-zinc-600 dark:text-zinc-400">
            {command.behavior.map((item) => (
              <li class="flex gap-3">
                <span class="mt-3 size-1.5 shrink-0 rounded-full bg-sky-500"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>

        {command.generated && (
          <section class="mt-12">
            <h2 class="text-2xl font-semibold tracking-tight text-zinc-950 dark:text-white">{command.generatedTitle}</h2>
            <ul class="mt-5 grid gap-4">
              {command.generated.map((item) => (
                <li class="grid gap-3 text-sm leading-7 text-zinc-600 dark:text-zinc-400 sm:grid-cols-[1rem_minmax(0,1fr)]">
                  <span class="mt-3 size-1.5 rounded-full bg-sky-500" aria-hidden="true"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section class="mt-12">
          <h2 class="text-2xl font-semibold tracking-tight text-zinc-950 dark:text-white">{command.nextTitle}</h2>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            {command.nextLinks.map((link) => (
              <a class="group inline-flex items-center justify-center rounded-full border border-zinc-300 px-5 py-3 text-sm font-semibold text-zinc-700 transition-colors hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-900" href={localizeHref(link.href)}>
                {link.label}
                <span class="ml-2 inline-block transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        </section>
      </article>
    </div>
    <script>
      document.querySelectorAll<HTMLButtonElement>("[data-copy-button]").forEach((button) => {
        const originalLabel = button.textContent || "Copy";

        button.addEventListener("click", async () => {
          const value = button.dataset.copyValue || "";

          try {
            await navigator.clipboard.writeText(value);
            button.textContent = "Copied";
            window.setTimeout(() => {
              button.textContent = originalLabel;
            }, 1600);
          } catch {
            button.textContent = "Failed";
            window.setTimeout(() => {
              button.textContent = originalLabel;
            }, 1600);
          }
        });
      });
    </script>
  </main>
</BaseLayout>
