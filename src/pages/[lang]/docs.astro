---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DocsMobileNav from "../../components/DocsMobileNav.astro";
import en from "../../messages/en/docs.json";
import es from "../../messages/es/docs.json";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}

const lang = Astro.params.lang === "es" ? "es" : "en";
const messages = lang === "es" ? es : en;

function localizeHref(href: string) {
  if (!href.startsWith("/")) return href;
  return `/${lang}${href}`;
}

const docCards = [
  ...messages.overviewCards,
  { title: messages.commands.title, description: messages.commands.description, href: "/docs/commands/" },
  { title: messages.output.title, description: messages.output.description, href: "/docs/generated-output/" },
  { title: messages.principles.title, description: messages.principles.description, href: "/docs/principles/" },
  { title: messages.roadmap.title, description: messages.roadmap.description, href: "/docs/roadmap/" },
];
---

<BaseLayout lang={lang} messages={messages}>
  <main class="px-6 pb-20 pt-32 sm:px-8 sm:pt-40 lg:px-10">
    <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[17rem_minmax(0,1fr)]">
      <aside class="hidden lg:block">
        <div class="sticky top-24 pl-1">
          {messages.sidebar.map((group) => (
            <nav class="py-4 first:pt-0 last:pb-0" aria-label={group.title}>
              <p class="text-sm font-semibold text-zinc-950 dark:text-white">{group.title}</p>
              <ul class="mt-3 grid gap-2">
                {group.links.map((link) => (
                  <li>
                    <a class="block rounded-md px-2 py-1.5 text-sm text-zinc-500 transition-colors hover:bg-zinc-100 hover:text-zinc-950 dark:text-zinc-400 dark:hover:bg-zinc-900 dark:hover:text-white" href={localizeHref(link.href)}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))}
        </div>
      </aside>

      <div>
        <DocsMobileNav lang={lang} groups={messages.sidebar} currentPath={Astro.url.pathname} />

        <section class="pb-12">
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-zinc-400">{messages.hero.eyebrow}</p>
          <h1 class="mt-5 max-w-4xl text-5xl font-semibold leading-[0.98] tracking-tight text-zinc-950 dark:text-white sm:text-7xl">
            {messages.hero.title}
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-500 dark:text-zinc-400">{messages.hero.description}</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a class="inline-flex items-center justify-center rounded-full bg-zinc-950 px-5 py-3 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5 hover:bg-zinc-800 dark:bg-white dark:text-zinc-950 dark:hover:bg-zinc-100" href={`/${lang}/docs/build-from-source/`}>
              {messages.cta.primary}
              <span class="ml-2" aria-hidden="true">→</span>
            </a>
            <a class="inline-flex items-center justify-center rounded-full border border-zinc-300 px-5 py-3 text-sm font-semibold text-zinc-700 transition-colors hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-900" href="https://github.com/sebas3261/mvnex" target="_blank" rel="noopener noreferrer">
              {messages.cta.secondary}
            </a>
          </div>
        </section>

        <section class="mt-12 grid gap-4 pb-12 md:grid-cols-2 xl:grid-cols-3">
          {docCards.map((card) => (
            <a class="group rounded-lg border border-zinc-200 bg-white p-6 transition-colors hover:border-zinc-400 dark:border-zinc-800 dark:bg-zinc-950 dark:hover:border-zinc-600" href={localizeHref(card.href)}>
              <h2 class="text-base font-semibold text-zinc-950 dark:text-white">{card.title}</h2>
              <p class="mt-3 text-sm leading-7 text-zinc-500 dark:text-zinc-400">{card.description}</p>
              <span class="mt-6 inline-flex text-sm font-semibold text-zinc-950 transition-transform group-hover:translate-x-1 dark:text-white" aria-hidden="true">→</span>
            </a>
          ))}
        </section>
      </div>
    </div>
  </main>
</BaseLayout>
