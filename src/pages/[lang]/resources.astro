---
import BaseLayout from "../../layouts/BaseLayout.astro";
import en from "../../messages/en/resources.json";
import es from "../../messages/es/resources.json";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}

const lang = Astro.params.lang === "es" ? "es" : "en";
const messages = lang === "es" ? es : en;

function localizeHref(href: string) {
  if (!href.startsWith("/")) return href;
  return `/${lang}${href}`;
}
---

<BaseLayout lang={lang} messages={messages}>
  <main class="px-6 pb-20 pt-44 sm:px-8 sm:pt-52 lg:px-10">
    <div class="mx-auto max-w-7xl">
      <section class="docs-reveal max-w-4xl pb-8 sm:pb-12">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-zinc-400">{messages.hero.eyebrow}</p>
        <h1 class="mt-5 text-5xl font-semibold leading-[0.98] tracking-tight text-zinc-950 dark:text-white sm:text-7xl">
          {messages.hero.title}
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-500 dark:text-zinc-400">{messages.hero.description}</p>
      </section>

      <div class="mt-16 grid gap-16">
        {messages.groups.map((group, groupIndex) => (
          <section class="scroll-reveal" style={`--reveal-delay: ${groupIndex * 90}ms`}>
            <div class="max-w-3xl">
              <h2 class="text-2xl font-semibold tracking-tight text-zinc-950 dark:text-white">{group.title}</h2>
              <p class="mt-3 text-sm leading-7 text-zinc-500 dark:text-zinc-400">{group.description}</p>
            </div>
            <div class="mt-8 grid gap-6">
              {group.items.map((item, itemIndex) => {
                const href = localizeHref(item.href);
                const external = item.href.startsWith("http");

                return (
                  <a
                    class="group interactive-lift scroll-reveal grid gap-3 border-t border-zinc-200 pt-5 transition-colors hover:border-zinc-400 dark:border-zinc-800 dark:hover:border-zinc-600 sm:grid-cols-[14rem_minmax(0,1fr)_2rem]"
                    style={`--reveal-delay: ${itemIndex * 70}ms`}
                    href={href}
                    target={external ? "_blank" : undefined}
                    rel={external ? "noopener noreferrer" : undefined}
                  >
                    <h3 class="font-mono text-sm font-semibold text-sky-600 dark:text-sky-300">{item.title}</h3>
                    <p class="text-sm leading-7 text-zinc-500 dark:text-zinc-400">{item.description}</p>
                    <span class="text-sm font-semibold text-zinc-950 transition-transform group-hover:translate-x-1 dark:text-white" aria-hidden="true">→</span>
                  </a>
                );
              })}
            </div>
          </section>
        ))}
      </div>

      <section class="scroll-reveal mt-20 border-t border-zinc-200 pt-10 dark:border-zinc-800">
        <div class="grid gap-8 lg:grid-cols-[minmax(0,0.7fr)_minmax(20rem,0.5fr)]">
          <div>
            <h2 class="text-2xl font-semibold tracking-tight text-zinc-950 dark:text-white">{messages.status.title}</h2>
            <p class="mt-3 text-sm leading-7 text-zinc-500 dark:text-zinc-400">{messages.status.description}</p>
          </div>
          <ul class="grid gap-4">
            {messages.status.items.map((item, index) => (
              <li class="scroll-reveal grid grid-cols-[2rem_minmax(0,1fr)] gap-4" style={`--reveal-delay: ${index * 70}ms`}>
                <span class="font-mono text-sm font-black text-sky-600 dark:text-sky-300">{String(index + 1).padStart(2, "0")}</span>
                <span class="text-sm leading-7 text-zinc-600 dark:text-zinc-400">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </div>
    <script>
      const revealItems = document.querySelectorAll<HTMLElement>(".scroll-reveal");
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.18, rootMargin: "0px 0px -8% 0px" }
      );

      revealItems.forEach((item) => observer.observe(item));
    </script>
  </main>
</BaseLayout>
