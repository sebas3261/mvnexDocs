---
interface SidebarLink {
  label: string;
  href: string;
}

interface SidebarGroup {
  title: string;
  links: SidebarLink[];
}

interface Props {
  lang: "en" | "es";
  groups: SidebarGroup[];
  currentPath: string;
}

const { lang, groups, currentPath } = Astro.props;
const label = lang === "es" ? "Menu de docs" : "Docs menu";
const closeLabel = lang === "es" ? "Cerrar menu de docs" : "Close docs menu";
const title = lang === "es" ? "Documentacion" : "Documentation";

function localizeHref(href: string) {
  if (!href.startsWith("/")) return href;
  return `/${lang}${href}`;
}

function isActive(href: string) {
  const localized = localizeHref(href);
  return currentPath === localized || currentPath === `${localized}/`;
}
---

<div class="docs-mobile-drawer lg:hidden" data-docs-drawer>
  <button class="fixed left-4 top-20 z-40 inline-flex size-10 items-center justify-center rounded-full border border-zinc-200 bg-white/90 text-zinc-700 shadow-sm shadow-zinc-950/5 outline-none transition-all hover:-translate-y-0.5 hover:border-zinc-300 hover:bg-white hover:text-zinc-950 focus-visible:ring-2 focus-visible:ring-zinc-400/40 dark:border-zinc-800 dark:bg-zinc-950/90 dark:text-zinc-300 dark:shadow-black/10 dark:hover:border-zinc-700 dark:hover:bg-zinc-950 dark:hover:text-white dark:focus-visible:ring-white/25 sm:left-6" type="button" data-docs-drawer-open aria-label={label} title={label}>
    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect width="18" height="14" x="3" y="5" rx="2"></rect>
      <path d="M9 5v14"></path>
      <path d="M6 9h0"></path>
      <path d="M6 12h0"></path>
    </svg>
  </button>

  <div class="docs-mobile-drawer-overlay fixed inset-0 z-[60] bg-transparent opacity-0"></div>
  <aside class="docs-mobile-drawer-panel fixed bottom-0 left-0 top-0 z-[70] w-[min(21rem,88vw)] overflow-y-auto border-r border-zinc-200 bg-white bg-[linear-gradient(180deg,rgba(14,165,233,0.08),transparent_18rem)] px-6 py-6 shadow-xl shadow-zinc-950/10 transition-transform duration-300 ease-out dark:border-zinc-800 dark:bg-zinc-950 dark:shadow-black/20">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-zinc-400">{title}</p>
        <p class="mt-2 text-xl font-semibold tracking-tight text-zinc-950 dark:text-white">{label}</p>
      </div>
      <button class="docs-mobile-drawer-close grid size-9 place-items-center rounded-full border border-zinc-200 text-lg leading-none text-zinc-500 outline-none transition-colors hover:bg-zinc-100 hover:text-zinc-950 focus-visible:ring-2 focus-visible:ring-zinc-400/40 dark:border-zinc-800 dark:text-zinc-400 dark:hover:bg-zinc-900 dark:hover:text-white dark:focus-visible:ring-white/25" type="button" aria-label={closeLabel}>
        ×
      </button>
    </div>

    <div class="mt-9">
      {groups.map((group) => (
        <nav class="py-4 first:pt-0 last:pb-0" aria-label={group.title}>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-zinc-400">{group.title}</p>
          <ul class="mt-3 grid gap-1">
            {group.links.map((link) => (
              <li>
                <a
                  class={`block rounded-lg px-3 py-2.5 text-sm font-medium transition-colors ${
                    isActive(link.href)
                      ? "bg-zinc-950 text-white dark:bg-white dark:text-zinc-950"
                      : "text-zinc-500 hover:bg-zinc-100 hover:text-zinc-950 dark:text-zinc-400 dark:hover:bg-zinc-900 dark:hover:text-white"
                  }`}
                  href={localizeHref(link.href)}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
  </aside>
  <script>
    document.querySelectorAll<HTMLElement>("[data-docs-drawer]").forEach((drawer) => {
      const openButton = drawer.querySelector<HTMLButtonElement>("[data-docs-drawer-open]");
      const closeButton = drawer.querySelector<HTMLButtonElement>(".docs-mobile-drawer-close");
      const overlay = drawer.querySelector<HTMLElement>(".docs-mobile-drawer-overlay");

      function openDrawer() {
        drawer.classList.add("is-open");
        openButton?.setAttribute("aria-expanded", "true");
        document.body.style.overflow = "hidden";
      }

      function closeDrawer() {
        drawer.classList.remove("is-open");
        openButton?.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";
      }

      openButton?.setAttribute("aria-expanded", "false");
      openButton?.addEventListener("click", openDrawer);
      closeButton?.addEventListener("click", closeDrawer);
      overlay?.addEventListener("click", closeDrawer);
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && drawer.classList.contains("is-open")) closeDrawer();
      });
      window.addEventListener("pageshow", closeDrawer);
      window.addEventListener("resize", () => {
        if (window.innerWidth >= 1024 && drawer.classList.contains("is-open")) closeDrawer();
      });
    });
  </script>
</div>
