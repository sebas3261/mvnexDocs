---
import "../styles/global.css";
import NavBar from "../components/NavBar.astro";

interface Props {
  lang: "en" | "es";
  messages: {
    meta: {
      title: string;
      description: string;
      ogTitle: string;
      ogDescription: string;
    };
    footer: {
      tagline: string;
      copyright: string;
    };
  };
}

const { lang, messages } = Astro.props;
const site = Astro.site ?? new URL("https://mvnex.sebas3261.com");
const normalizedPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonical = new URL(normalizedPath, site);
const englishPath = normalizedPath.replace(/^\/(en|es)(?=\/|$)/, "/en");
const spanishPath = normalizedPath.replace(/^\/(en|es)(?=\/|$)/, "/es");
const year = new Date().getFullYear();

const footer = lang === "es"
  ? {
      description:
        "Una CLI nativa para mejorar la experiencia de desarrollo en proyectos Maven sin reemplazar Maven.",
      headline: "Maven sigue siendo Maven. La experiencia se vuelve mas rapida.",
      navigationTitle: "Sitio",
      docsTitle: "Documentation",
      projectTitle: "Proyecto",
      home: "Inicio",
      documentation: "Documentation",
      buildFromSource: "Build from source",
      createProject: "Crear proyecto",
      resources: "Resources",
      github: "GitHub",
      profile: "Perfil",
      repository: "Repositorio",
      builtBy: "Creado por Sebastian Sanchez.",
      domain: "mvnex.sebas3261.com",
    }
  : {
      description:
        "A native CLI for improving the developer experience around Maven projects without replacing Maven.",
      headline: "Maven stays Maven. The experience gets faster.",
      navigationTitle: "Site",
      docsTitle: "Documentation",
      projectTitle: "Project",
      home: "Home",
      documentation: "Documentation",
      buildFromSource: "Build from source",
      createProject: "Create project",
      resources: "Resources",
      github: "GitHub",
      profile: "Profile",
      repository: "Repository",
      builtBy: "Built by Sebastian Sanchez.",
      domain: "mvnex.sebas3261.com",
    };

const footerColumns = [
  {
    title: footer.navigationTitle,
    links: [
      { label: footer.home, href: `/${lang}/` },
      { label: footer.documentation, href: `/${lang}/docs/` },
      { label: footer.resources, href: `/${lang}/resources/` },
    ],
  },
  {
    title: footer.docsTitle,
    links: [
      { label: footer.documentation, href: `/${lang}/docs/` },
      { label: footer.buildFromSource, href: `/${lang}/docs/build-from-source/` },
      { label: footer.createProject, href: `/${lang}/docs/create-project/` },
    ],
  },
  {
    title: footer.projectTitle,
    links: [
      {
        label: footer.github,
        href: "https://github.com/sebas3261/mvnex",
        external: true,
      },
      {
        label: footer.profile,
        href: "https://sebas3261.com",
        external: true,
      },
      {
        label: footer.repository,
        href: "https://github.com/sebas3261/mvnex",
        external: true,
      },
    ],
  },
];
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{messages.meta.title}</title>
    <meta name="description" content={messages.meta.description} />
    <meta name="author" content="Sebastian Sanchez" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(englishPath, site)} />
    <link rel="alternate" hreflang="es" href={new URL(spanishPath, site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(englishPath, site)} />
    <link rel="icon" href="/favicon-dark.svg" type="image/svg+xml" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon-light.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={messages.meta.ogTitle} />
    <meta property="og:description" content={messages.meta.ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="mvnex Docs" />
    <meta property="og:locale" content={lang === "es" ? "es_CO" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "es" ? "en_US" : "es_CO"} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={messages.meta.ogTitle} />
    <meta name="twitter:description" content={messages.meta.ogDescription} />
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch (e) {}
        var dark = stored === "dark" || (!stored && window.matchMedia("(prefers-color-scheme: dark)").matches);
        if (dark) {
          document.documentElement.classList.add("dark");
          document.documentElement.style.colorScheme = "dark";
        } else {
          document.documentElement.style.colorScheme = "light";
        }
      })();
    </script>
  </head>
  <body class="bg-white text-zinc-950 antialiased dark:bg-zinc-950 dark:text-white">
    <div class="min-h-screen bg-[linear-gradient(180deg,rgba(14,165,233,0.08),transparent_28rem)]">
      <NavBar lang={lang} />

      <slot />

      <footer class="border-t border-zinc-200 bg-white px-6 py-14 text-zinc-950 dark:border-zinc-800 dark:bg-zinc-950 dark:text-white sm:px-8 sm:py-20 lg:px-10">
        <div class="mx-auto max-w-7xl">
          <div class="grid gap-12 lg:grid-cols-[minmax(0,1.1fr)_repeat(3,minmax(8rem,0.45fr))]">
            <div>
              <a href={`/${lang}/`} class="inline-flex items-center gap-3 transition-opacity hover:opacity-70" aria-label="mvnex home">
                <img src="/logo-dark.svg" alt="mvnex" class="h-10 w-auto dark:hidden" />
                <img src="/logo.svg" alt="mvnex" class="hidden h-10 w-auto dark:block" />
                <span class="text-base font-semibold">mvnex</span>
              </a>
              <p class="mt-6 max-w-md text-2xl font-semibold leading-tight tracking-tight sm:text-4xl">
                {footer.headline}
              </p>
              <p class="mt-5 max-w-md text-sm leading-7 text-zinc-500 dark:text-zinc-400">
                {footer.description}
              </p>
            </div>

            {footerColumns.map((column) => (
              <nav aria-label={column.title}>
                <p class="text-xs font-semibold uppercase tracking-[0.22em] text-zinc-400">{column.title}</p>
                <ul class="mt-5 grid gap-3">
                  {column.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        target={link.external ? "_blank" : undefined}
                        rel={link.external ? "noopener noreferrer" : undefined}
                        class="text-sm font-medium text-zinc-500 transition-colors hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-white"
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            ))}
          </div>

          <div class="mt-14 flex flex-col gap-3 border-t border-zinc-100 pt-6 text-xs text-zinc-400 dark:border-zinc-800 sm:flex-row sm:items-center sm:justify-between">
            <p>
              © {year}{" "}
              <a class="transition-colors hover:text-zinc-950 dark:hover:text-white" href="https://sebas3261.com" target="_blank" rel="noopener noreferrer">
                Sebastian Sanchez
              </a>
              . {messages.footer.copyright}
            </p>
            <div class="flex flex-wrap gap-x-4 gap-y-2">
              <p>{footer.builtBy}</p>
              <p>{footer.domain}</p>
            </div>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
